generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Domain models
// ---------------------------------------------------------------------------

model Organization {
  id                    String   @id @default(cuid())
  githubOrgId           String   @unique
  githubLogin           String
  name                  String?
  avatarUrl             String?
  installationId        BigInt?  @unique
  installationSuspended Boolean  @default(false)
  isPersonal            Boolean  @default(false)
  llmMode               LlmMode  @default(SERVICE)
  llmProvider           LlmProvider @default(OPENROUTER)
  llmModel              String?
  aiCredits             Int      @default(15)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  members              OrganizationMember[]
  repositories         Repository[]
  reviewRules          ReviewRule[]
  notificationChannels NotificationChannel[]
  creditTransactions   CreditTransaction[]
  laudos               Laudo[]
}

model User {
  id          String   @id @default(cuid())
  githubId    String   @unique
  githubLogin String
  name        String?
  email       String?
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships OrganizationMember[]
  accounts    Account[]
  sessions    Session[]
  laudos      Laudo[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole  @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model Repository {
  id             String   @id @default(cuid())
  githubRepoId   BigInt   @unique
  organizationId String
  fullName       String
  name           String
  private        Boolean  @default(false)
  isActive       Boolean  @default(true)
  defaultBranch  String   @default("main")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviews      PullRequestReview[]
  laudos       Laudo[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Regras de revisão
// ---------------------------------------------------------------------------

enum RuleSeverity {
  INFO
  WARNING
  ERROR
}

model ReviewRule {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  instruction    String       @db.Text
  severity       RuleSeverity @default(WARNING)
  enabled        Boolean      @default(true)
  appliesToAll   Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Canais de notificação
// ---------------------------------------------------------------------------

enum NotificationType {
  EMAIL
  SLACK
  DISCORD
  TEAMS
}

model NotificationChannel {
  id             String           @id @default(cuid())
  organizationId String
  type           NotificationType
  label          String
  target         String
  enabled        Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@index([organizationId])
}

enum NotificationDeliveryStatus {
  SUCCESS
  FAILED
}

// Histórico de envios de notificação — uma linha por tentativa (canal x
// review). Retenção: aplicada pelo dispatcher (pruneNotificationHistory em
// lib/notifications), não pelo schema — até 100 por organização e até 90
// dias, o que for mais restritivo.
model NotificationDelivery {
  id        String                     @id @default(cuid())
  channelId String
  reviewId  String
  status    NotificationDeliveryStatus
  error     String?                    @db.Text
  createdAt DateTime                   @default(now())

  channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  review  PullRequestReview   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([reviewId])
}

// ---------------------------------------------------------------------------
// Revisões de Pull Requests
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum LlmProvider {
  OPENROUTER
  ANTHROPIC
}

// Origem da IA usada pela organização:
// - SERVICE: usa a IA do próprio serviço (OpenRouter gratuito por padrão, com
//   fallback automático entre modelos gratuitos e, para orgs com créditos, o
//   Claude/agy hospedado na VPS como fallback premium de alta disponibilidade).
// - BYOK: a organização usa a própria chave de API (OpenRouter ou Claude).
enum LlmMode {
  SERVICE
  BYOK
}

// Registro de entregas de webhook para garantir idempotência.
model WebhookEvent {
  id          String    @id @default(cuid())
  deliveryId  String    @unique
  eventType   String
  action      String?
  status      String    @default("RECEIVED")
  error       String?   @db.Text
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

enum FindingSeverity {
  INFO
  WARNING
  ERROR
}

model PullRequestReview {
  id           String       @id @default(cuid())
  repositoryId String
  prNumber     Int
  prTitle      String
  author       String
  authorAvatar String?
  branch       String
  commitSha    String?
  status          ReviewStatus @default(PENDING)
  summary         String?      @db.Text
  diff            String?      @db.Text
  deliveryId      String?
  attempts        Int          @default(0)
  error           String?      @db.Text
  llmProvider     String?
  llmModel        String?
  postedToGithub  Boolean      @default(false)
  githubReviewId  BigInt?
  postError       String?      @db.Text
  prMerged        Boolean      @default(false)
  prClosedAt      DateTime?
  queuedAt        DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  repository         Repository          @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings           ReviewFinding[]
  creditTransactions CreditTransaction[]
  notificationDeliveries NotificationDelivery[]

  @@unique([repositoryId, prNumber])
  @@index([repositoryId])
  @@index([status])
}

model ReviewFinding {
  id         String          @id @default(cuid())
  reviewId   String
  filePath   String
  line       Int?
  severity   FindingSeverity @default(WARNING)
  title      String
  message    String          @db.Text
  suggestion String?         @db.Text
  createdAt  DateTime        @default(now())

  review PullRequestReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
}

// ---------------------------------------------------------------------------
// Laudos (relatório de qualidade de repositório inteiro, com dupla checagem)
// ---------------------------------------------------------------------------

enum LaudoSource {
  REGISTERED
  PUBLIC_URL
}

// Confiança do apontamento: CONFIRMED_BOTH quando a IA gratuita já havia
// encontrado o mesmo problema e o Claude confirmou na dupla checagem;
// CLAUDE_ONLY quando só o Claude identificou (etapa gratuita indisponível,
// ou o Claude descartou o apontamento original e reescreveu/adicionou o seu).
enum LaudoFindingSource {
  CONFIRMED_BOTH
  CLAUDE_ONLY
}

enum LaudoArtifactType {
  PDF
  MARKDOWN
}

model Laudo {
  id                String       @id @default(cuid())
  organizationId    String
  requestedByUserId String
  source            LaudoSource
  repositoryId      String?
  publicRepoUrl     String?
  branch            String?
  status            ReviewStatus @default(PENDING)
  attempts          Int          @default(0)
  error             String?      @db.Text
  summary           String?      @db.Text
  scoreLetter       String?
  scoreNumber       Int?
  filesScanned      Int          @default(0)
  filesSkipped      Int          @default(0)
  truncated         Boolean      @default(false)
  usedClaudeOnly    Boolean      @default(false)
  freeModel         String?
  claudeModel       String?
  queuedAt          DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy        User                @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  repository         Repository?         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  findings           LaudoFinding[]
  artifacts          LaudoArtifact[]
  creditTransactions CreditTransaction[]

  @@index([organizationId])
  @@index([status])
}

model LaudoFinding {
  id         String             @id @default(cuid())
  laudoId    String
  filePath   String
  line       Int?
  severity   FindingSeverity    @default(WARNING)
  title      String
  message    String             @db.Text
  suggestion String?            @db.Text
  source     LaudoFindingSource @default(CLAUDE_ONLY)
  createdAt  DateTime           @default(now())

  laudo Laudo @relation(fields: [laudoId], references: [id], onDelete: Cascade)

  @@index([laudoId])
}

model LaudoArtifact {
  id        String            @id @default(cuid())
  laudoId   String
  type      LaudoArtifactType
  fileName  String
  filePath  String
  sizeBytes Int
  createdAt DateTime          @default(now())

  laudo Laudo @relation(fields: [laudoId], references: [id], onDelete: Cascade)

  @@index([laudoId])
}

// ---------------------------------------------------------------------------
// NextAuth required tables (PrismaAdapter)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum CreditTransactionType {
  PURCHASE
  USAGE
  ADJUSTMENT
}

// Histórico de créditos por organização. USAGE é gravado automaticamente
// junto do decremento em lib/queue.ts; PURCHASE/ADJUSTMENT ficam com a
// estrutura pronta para quando existir um fluxo real de compra/billing.
model CreditTransaction {
  id             String                @id @default(cuid())
  organizationId String
  type           CreditTransactionType
  amount         Int
  reviewId       String?
  laudoId        String?
  note           String?
  createdAt      DateTime              @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  review       PullRequestReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  laudo        Laudo?             @relation(fields: [laudoId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([reviewId])
  @@index([laudoId])
}
