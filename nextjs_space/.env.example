# ===========================================================================
# Code Review SaaS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores.
# ===========================================================================

# ---------------------------------------------------------------------------
# NextAuth / App
# ---------------------------------------------------------------------------
AUTH_SECRET=                          # Segredo aleatório (mín. 32 chars): openssl rand -hex 32
NEXTAUTH_URL=http://localhost:3000    # URL base da app (produção: https://seu-dominio.com)

# ---------------------------------------------------------------------------
# Banco de Dados (PostgreSQL)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codereview

# ---------------------------------------------------------------------------
# GitHub App (OAuth + Webhooks)
# Criar em: https://github.com/settings/apps
# ---------------------------------------------------------------------------
GITHUB_APP_CLIENT_ID=                 # Client ID do OAuth
GITHUB_APP_CLIENT_SECRET=             # Client Secret do OAuth
GITHUB_APP_ID=                        # App ID (numérico)
GITHUB_APP_PRIVATE_KEY_BASE64=        # Chave PEM em base64: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.pem"))
GITHUB_WEBHOOK_SECRET=                # Segredo do webhook
GITHUB_APP_NAME=                      # Nome do app (slug usado na URL de instalação)

# ---------------------------------------------------------------------------
# IA — OpenRouter (gratuito, primeira opção no modo SERVICE)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=                   # Chave do OpenRouter (sk-or-v1-...)

# ---------------------------------------------------------------------------
# IA — Anthropic (BYOK — chave própria da organização)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=                  # Opcional: chave padrão para modo BYOK

# ---------------------------------------------------------------------------
# IA — Fallback Premium na VPS (Claude CLI via proxy)
# Só acionado quando a org tem créditos e os modelos free falharam.
# ---------------------------------------------------------------------------
# SERVICE_CLAUDE_BASE_URL=http://ip-da-vps:8787
# SERVICE_CLAUDE_API_KEY=chave-do-proxy
# SERVICE_CLAUDE_MODEL=claude

# ---------------------------------------------------------------------------
# IA — Fallback Premium na VPS (Agy CLI via proxy)
# ---------------------------------------------------------------------------
# SERVICE_AGY_BASE_URL=http://ip-da-vps:8787
# SERVICE_AGY_API_KEY=chave-do-proxy
# SERVICE_AGY_MODEL=agy

# ---------------------------------------------------------------------------
# Worker / Cron (processamento de reviews pendentes)
# ---------------------------------------------------------------------------
WORKER_SECRET=                        # Segredo para autenticar chamadas ao /api/jobs/process

# ---------------------------------------------------------------------------
# Notificações — E-mail (opcional)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=                     # Chave do Resend (re_...) para envio de e-mails
# EMAIL_FROM=noreply@codereview.app   # Endereço de origem dos e-mails

